# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=contact-center-docs
PINECONE_ENVIRONMENT=gcp-starter

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/contact_center
MONGODB_DB_NAME=contact_center

# LangSmith (optional)
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=contact-center-ai

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=BAAI/bge-reranker-large
