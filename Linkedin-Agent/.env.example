# LinkedIn Agent Environment Variables

# ============================================
# OpenRouter LLM Configuration (REQUIRED)
# ============================================
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Choose LLM model (examples: mistral/mistral-7b-instruct, meta-llama/llama-2-70b-chat, anthropic/claude-2)
# Mistral is recommended for cost-effectiveness
OPENROUTER_MODEL=mistral/mistral-7b-instruct

# ============================================
# NewsAPI Configuration (OPTIONAL)
# ============================================
# Get free API key from https://newsapi.org/
# Free tier: 100 requests/day
NEWSAPI_KEY=your_newsapi_key_here

# ============================================
# Reddit Configuration (OPTIONAL)
# ============================================
# Create app at https://www.reddit.com/prefs/apps
# For public subreddits, you can use without authentication
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=LinkedInAgent/1.0 (by YourUsername)

# ============================================
# Database Configuration
# ============================================
# Path where SQLite database will be stored
DATABASE_PATH=./data/linkedin_agent.db

# ============================================
# Scheduler Configuration
# ============================================
# Time to run daily content generation (24-hour format)
SCHEDULE_TIME=09:00

# Timezone for scheduler (see pytz timezones)
SCHEDULE_TIMEZONE=UTC

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# Content Configuration
# ============================================
# Maximum number of interview questions to gather
MAX_INTERVIEW_QUESTIONS=5

# Maximum number of news items to gather
MAX_NEWS_ITEMS=10

# Number of post variations to generate
GENERATE_POST_VARIATIONS=3

# ============================================
# Output Configuration
# ============================================
# Directory for generated posts
POSTS_OUTPUT_DIR=./generated_posts

# ============================================
# Rate Limiting
# ============================================
# Delay between HTTP requests (seconds) - avoid rate limiting
REQUEST_DELAY=2

# Content cache duration (hours)
CACHE_DURATION=24
